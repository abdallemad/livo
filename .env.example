# Copy to .env (or .env.local) and fill in. Never commit real values.

# --- Database (PostgreSQL) ---
# Pooled (transaction pooler) URL — runtime + build. Keep connection_limit=5 & pool_timeout=30.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DB?pgbouncer=true&connection_limit=5&pool_timeout=30"
# Session/direct URL — Prisma CLI & schema changes only.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB"

# --- Public origin (REQUIRED in production: canonicals, sitemap, robots, payment return URLs) ---
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"

# --- Clerk (use pk_live_/sk_live_ in production) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/auth-callback"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/auth-callback"

# --- Cloudflare R2 (private bucket) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Optional images-only public host. NEVER point at a bucket holding private files.
NEXT_PUBLIC_R2_PUBLIC_URL=""

# --- Analytics (production builds only) ---
NEXT_PUBLIC_GA_ID=""

# --- Optional: version-skew protection id (auto-generated per build) ---
# NEXT_DEPLOYMENT_ID=""
