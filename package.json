{
  "name": "livo-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "prebuild": "node scripts/prebuild-db.cjs",
    "build": "node scripts/build-with-deployment-id.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "test": "node --test --import ./tests/register-aliases.mjs \"tests/**/*.test.ts\" \"tests/**/*.test.cjs\"",
    "warm": "node scripts/warm-cache.mjs",
    "check-env": "node tests/prelaunch/check-env.mjs",
    "db:generate": "prisma generate",
    "db:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@base-ui/react": "^1.9.0",
    "@clerk/nextjs": "^7.9.23",
    "@hookform/resolvers": "^7.0.0",
    "@next/third-parties": "^16.4.3",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-dropzone": "^20.1.4",
    "react-hook-form": "^7.91.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
